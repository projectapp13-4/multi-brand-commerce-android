<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- SDK 36 defines disabled as enum 64; older runtimes ignore the new attribute. -->
    <application android:pageSizeCompat="disabled">
        <activity
            android:name="com.gurbakir.mobile.localization.AppLocaleProbeActivity"
            android:exported="false" />
        <activity
            android:name="com.gurbakir.mobile.home.OwnedHomeVideoRotationActivity"
            android:exported="false" />
        <activity
            android:name="com.gurbakir.mobile.checkout.CheckoutOwnerProbeActivity"
            android:exported="false" />
        <service
            android:name="com.gurbakir.mobile.account.ProtectedStateBeforeClearService"
            android:exported="false"
            android:process=":protectedStateBeforeClear" />
        <service
            android:name="com.gurbakir.mobile.account.ProtectedStateAfterClearService"
            android:exported="false"
            android:process=":protectedStateAfterClear" />
        <!-- OAuth callbacks belong to the app; this standalone harness uses inert content. -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            tools:node="remove" />
    </application>
</manifest>
